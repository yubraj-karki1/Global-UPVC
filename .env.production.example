# Public HTTPS origins. NEXT_PUBLIC_* values are embedded in the frontend image at build time.
NEXT_PUBLIC_SITE_URL=https://www.example.com
NEXT_PUBLIC_API_URL=https://api.example.com
ALLOWED_ORIGINS=https://www.example.com

# External MongoDB Atlas URI. Keep this private and URL-encode special characters in credentials.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/global-upvc?retryWrites=true&w=majority

# Generate unique values. ADMIN_PASSWORD must be at least 12 characters; JWT_SECRET at least 32.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters
JWT_SECRET=replace-with-at-least-32-random-characters

# Set true only when the API is behind a trusted proxy; set hops for your host.
TRUST_PROXY=false
TRUST_PROXY_HOPS=1

# Optional HTTPS webhook for new enquiry notifications.
ENQUIRY_NOTIFICATION_WEBHOOK_URL=

# Optional published host ports.
WEB_PORT=3000
API_PORT=5000
