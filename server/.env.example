MONGODB_URI=mongodb://127.0.0.1:27017/global-upvc
PORT=5000
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters
JWT_SECRET=replace-with-at-least-32-random-characters
ALLOWED_ORIGINS=http://localhost:3000
# Set true only when the API is behind one trusted reverse proxy.
TRUST_PROXY=false
# Optional: receives a JSON POST whenever a new enquiry is saved.
ENQUIRY_NOTIFICATION_WEBHOOK_URL=
